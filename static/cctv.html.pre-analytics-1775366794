<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CCTV Control Centre — AyrTraffic</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/WispAyr/wispayr-design@main/css/wispayr.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    :root { --grid-cols: 8; --grid-gap: 6px; }
    body { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#0a0e17; }
    .w-header { flex-shrink:0; } .w-footer { display:none; }

    #topbar { background:var(--w-bg-card,#1a1f2e); border-bottom:1px solid var(--w-border,#2a2f3e); display:flex; align-items:center; padding:6px 16px; gap:12px; flex-shrink:0; z-index:100; flex-wrap:wrap; }
    .topbar-title { display:flex; align-items:center; gap:10px; font-weight:800; font-size:15px; letter-spacing:-0.02em; white-space:nowrap; }
    .topbar-title .icon { font-size:20px; }
    .sensor-stats { display:flex; gap:8px; align-items:center; margin-left:8px; }
    .sensor-pill { display:flex; align-items:center; gap:5px; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:600; white-space:nowrap; }
    .sensor-pill.online  { background:rgba(34,197,94,.12); color:#22c55e; }
    .sensor-pill.stale   { background:rgba(245,158,11,.12); color:#f59e0b; }
    .sensor-pill.offline { background:rgba(239,68,68,.12); color:#ef4444; }
    .health-bar { width:80px; height:5px; border-radius:3px; background:rgba(255,255,255,.08); overflow:hidden; }
    .health-bar-fill { height:100%; border-radius:3px; background:#22c55e; transition:width .8s ease; }
    .vision-summary { display:flex; gap:8px; align-items:center; }
    .vision-pill { display:flex; align-items:center; gap:4px; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:600; white-space:nowrap; background:rgba(255,255,255,.06); color:#94a3b8; }
    .topbar-right { margin-left:auto; display:flex; align-items:center; gap:8px; }
    #search-input { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:6px; padding:4px 10px; font-size:12px; color:var(--w-text,#e2e8f0); outline:none; width:150px; transition:border .2s; }
    #search-input:focus { border-color:#3b82f6; }
    #search-input::placeholder { color:rgba(255,255,255,.3); }
    .grid-btn { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:6px; padding:4px 8px; font-size:11px; color:var(--w-text-muted,#94a3b8); cursor:pointer; transition:all .2s; white-space:nowrap; }
    .grid-btn:hover { background:rgba(255,255,255,.1); }
    .grid-btn.active { background:#3b82f6; color:#fff; border-color:#3b82f6; }
    #last-fetch { font-size:10px; color:var(--w-text-light,#64748b); white-space:nowrap; }

    #zone-bar { background:var(--w-bg-card,#1a1f2e); border-bottom:1px solid var(--w-border,#2a2f3e); display:flex; align-items:center; padding:4px 16px; gap:6px; flex-shrink:0; overflow-x:auto; overflow-y:hidden; }
    .zone-btn { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:3px 12px; font-size:11px; font-weight:500; color:var(--w-text-muted,#94a3b8); cursor:pointer; transition:all .2s; white-space:nowrap; display:flex; align-items:center; gap:5px; }
    .zone-btn:hover { background:rgba(255,255,255,.08); color:var(--w-text,#e2e8f0); }
    .zone-btn.active { background:#3b82f6; color:#fff; border-color:#3b82f6; }
    .zone-count { background:rgba(255,255,255,.15); border-radius:8px; padding:0 5px; font-size:10px; font-weight:700; min-width:16px; text-align:center; }
    .zone-btn.active .zone-count { background:rgba(255,255,255,.25); }

    #vision-alerts { display:none; background:rgba(245,158,11,.08); border-bottom:1px solid rgba(245,158,11,.2); padding:6px 16px; font-size:12px; color:#fbbf24; align-items:center; gap:10px; flex-shrink:0; overflow-x:auto; white-space:nowrap; }
    #vision-alerts.visible { display:flex; }
    .alert-item { display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:6px; font-weight:600; flex-shrink:0; background:rgba(245,158,11,.1); }
    .alert-item.frozen { color:#a78bfa; background:rgba(139,92,246,.1); }
    .alert-item.fog { color:#d6d3d1; background:rgba(168,162,158,.15); }
    .alert-item.congestion { color:#f87171; background:rgba(239,68,68,.1); }
    .alert-item.rain_on_lens { color:#60a5fa; background:rgba(59,130,246,.1); }
    .alert-item.broken_camera { color:#f87171; background:rgba(239,68,68,.12); }
    .alert-dismiss { margin-left:auto; cursor:pointer; color:rgba(255,255,255,.4); font-size:16px; padding:0 4px; flex-shrink:0; }
    .alert-dismiss:hover { color:#fff; }

    #camera-grid { flex:1; overflow-y:auto; overflow-x:hidden; padding:var(--grid-gap); display:grid; grid-template-columns:repeat(var(--grid-cols),1fr); gap:var(--grid-gap); align-content:start; }
    .cam-tile { position:relative; background:#111827; border:1px solid rgba(255,255,255,.06); border-radius:6px; overflow:hidden; aspect-ratio:4/3; cursor:pointer; transition:border-color .2s, box-shadow .2s; }
    .cam-tile:hover { border-color:#3b82f6; box-shadow:0 0 12px rgba(59,130,246,.2); }
    .cam-tile.offline { opacity:0.45; }
    .cam-tile.broken { opacity:0.35; border-color:rgba(239,68,68,.4); }
    .cam-tile.broken:hover { border-color:#ef4444; }
    .cam-tile img { width:100%; height:100%; object-fit:cover; display:block; }
    .cam-overlay { position:absolute; bottom:0; left:0; right:0; padding:20px 8px 6px; background:linear-gradient(transparent,rgba(0,0,0,.85)); display:flex; align-items:flex-end; justify-content:space-between; }
    .cam-name { font-size:11px; font-weight:600; color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.8); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:70%; }
    .cam-status { display:flex; align-items:center; gap:4px; font-size:10px; font-weight:600; }
    .cam-status-dot { width:7px; height:7px; border-radius:50%; }
    .cam-status.live .cam-status-dot { background:#22c55e; box-shadow:0 0 6px #22c55e; }
    .cam-status.live { color:#22c55e; }
    .cam-status.stale .cam-status-dot { background:#f59e0b; box-shadow:0 0 6px #f59e0b; }
    .cam-status.stale { color:#f59e0b; }
    .cam-status.offline .cam-status-dot { background:#ef4444; }
    .cam-status.offline { color:#ef4444; }
    .cam-topbar { position:absolute; top:0; left:0; right:0; padding:4px 8px; display:flex; justify-content:space-between; align-items:center; background:linear-gradient(rgba(0,0,0,.6),transparent); }
    .cam-id { font-size:9px; font-weight:600; color:rgba(255,255,255,.5); font-family:'Courier New',monospace; }
    .cam-age { font-size:9px; color:rgba(255,255,255,.4); }
    .cam-vision { position:absolute; top:0; right:0; padding:3px 6px; display:flex; gap:3px; align-items:center; z-index:2; }
    .vision-badge { font-size:9px; font-weight:700; padding:1px 5px; border-radius:4px; line-height:1.4; }
    .vision-weather { background:rgba(56,189,248,.18); color:#38bdf8; }
    .vision-activity { padding:1px 5px; border-radius:4px; font-size:9px; font-weight:700; line-height:1.4; }
    .vision-activity.frozen  { background:rgba(139,92,246,.2); color:#a78bfa; }
    .vision-activity.static  { background:rgba(100,116,139,.2); color:#94a3b8; }
    .vision-activity.light   { background:rgba(34,197,94,.15); color:#4ade80; }
    .vision-activity.moderate { background:rgba(245,158,11,.18); color:#fbbf24; }
    .vision-activity.heavy   { background:rgba(239,68,68,.18); color:#f87171; }
    .vision-fog { background:rgba(168,162,158,.2); color:#d6d3d1; }
    .vision-rain { background:rgba(59,130,246,.18); color:#60a5fa; }
    .vision-broken { background:rgba(239,68,68,.2); color:#f87171; font-weight:800; }
    .vision-vehicles { font-size:9px; font-weight:700; padding:1px 5px; border-radius:4px; line-height:1.4; }
    .vision-vehicles.empty { display:none; }
    .vision-vehicles.light { background:rgba(34,197,94,.15); color:#4ade80; }
    .vision-vehicles.moderate { background:rgba(245,158,11,.18); color:#fbbf24; }
    .vision-vehicles.heavy { background:rgba(239,68,68,.15); color:#f87171; }
    .vision-vehicles.congested { background:rgba(239,68,68,.25); color:#f87171; font-weight:800; }
    .vision-incident { font-size:9px; font-weight:700; padding:1px 5px; border-radius:4px; line-height:1.4; background:rgba(239,68,68,.25); color:#f87171; animation:pulse-incident 2s infinite; }
    @keyframes pulse-incident { 0%,100%{opacity:1;}50%{opacity:.6;} }
    .lb-scene-desc { width:100%; max-width:700px; margin-top:4px; padding:10px 14px; background:rgba(59,130,246,.06); border:1px solid rgba(59,130,246,.15); border-radius:8px; font-size:13px; color:#94a3b8; line-height:1.5; }
    .lb-scene-desc .label { font-size:11px; font-weight:700; color:#3b82f6; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px; }
    .lb-incidents { width:100%; max-width:700px; margin-top:4px; }
    .lb-incident-item { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:6px; font-size:12px; font-weight:600; margin:2px 4px 2px 0; }
    .lb-incident-item.critical { background:rgba(239,68,68,.15); color:#f87171; border:1px solid rgba(239,68,68,.2); }
    .lb-incident-item.warning { background:rgba(245,158,11,.12); color:#fbbf24; border:1px solid rgba(245,158,11,.2); }
    .lb-incident-item.info { background:rgba(59,130,246,.1); color:#60a5fa; border:1px solid rgba(59,130,246,.15); }
    .vision-road-type { font-size:8px; font-weight:700; padding:1px 5px; border-radius:4px; line-height:1.4; text-transform:uppercase; letter-spacing:0.02em; }
    .road-motorway { background:rgba(239,68,68,.15); color:#f87171; }
    .road-dual { background:rgba(245,158,11,.15); color:#fbbf24; }
    .road-single { background:rgba(34,197,94,.15); color:#4ade80; }
    .road-complex { background:rgba(168,85,247,.15); color:#c084fc; }
    .broken-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.5); z-index:1; }
    .broken-label { font-size:11px; font-weight:700; color:#f87171; background:rgba(239,68,68,.12); padding:4px 10px; border-radius:6px; border:1px solid rgba(239,68,68,.25); }

    #lightbox { display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.92); backdrop-filter:blur(8px); flex-direction:column; align-items:center; justify-content:center; }
    #lightbox.open { display:flex; }
    .lb-close { position:absolute; top:16px; right:24px; font-size:28px; color:rgba(255,255,255,.6); cursor:pointer; transition:color .2s; z-index:10; }
    .lb-close:hover { color:#fff; }
    .lb-content { max-width:90vw; max-height:80vh; display:flex; flex-direction:column; align-items:center; gap:12px; }
    .lb-img { max-width:100%; max-height:60vh; border-radius:8px; border:2px solid rgba(255,255,255,.1); box-shadow:0 8px 40px rgba(0,0,0,.6); }
    .lb-info { display:flex; align-items:center; gap:16px; color:#e2e8f0; }
    .lb-name { font-size:18px; font-weight:700; }
    .lb-meta { font-size:13px; color:#94a3b8; }
    .lb-nav { display:flex; gap:10px; margin-top:8px; }
    .lb-nav-btn { background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15); border-radius:8px; padding:8px 20px; color:#e2e8f0; cursor:pointer; font-size:13px; transition:all .2s; }
    .lb-nav-btn:hover { background:rgba(255,255,255,.15); }
    .lb-vision { display:none; width:100%; max-width:700px; margin-top:4px; padding:10px 14px; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:8px; }
    .lb-vision.visible { display:block; }
    .lb-vision-title { font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px; }
    .lb-vision-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:8px; }
    .lb-vision-stat { display:flex; flex-direction:column; gap:2px; }
    .lb-vision-stat .label { font-size:10px; color:#64748b; text-transform:uppercase; letter-spacing:0.04em; }
    .lb-vision-stat .value { font-size:14px; font-weight:700; color:#e2e8f0; }

    #minimap-wrap { position:fixed; bottom:16px; right:16px; z-index:500; }
    #minimap { width:240px; height:180px; border-radius:8px; border:1px solid rgba(255,255,255,.15); overflow:hidden; box-shadow:0 4px 20px rgba(0,0,0,.5); }
    @media (max-width:1100px) { #minimap { width:180px; height:130px; } }
    @media (max-width:768px) { #minimap-wrap { display:none; } }
    .no-results { grid-column:1/-1; text-align:center; padding:60px 20px; color:var(--w-text-muted,#64748b); font-size:15px; }
    @media (max-width:900px) { :root { --grid-cols:2; } #topbar { padding:6px 10px; } .sensor-stats,.vision-summary { display:none; } #search-input { width:100px; } }
    #camera-grid::-webkit-scrollbar { width:6px; } #camera-grid::-webkit-scrollbar-track { background:transparent; } #camera-grid::-webkit-scrollbar-thumb { background:rgba(255,255,255,.1); border-radius:3px; }
    .cam-tile.loading { background:linear-gradient(110deg,#111827 30%,#1a2332 50%,#111827 70%); background-size:200% 100%; animation:shimmer 1.5s infinite; }
    @keyframes shimmer { 0% { background-position:200% 0; } 100% { background-position:-200% 0; } }
    #zone-bar::-webkit-scrollbar { height:3px; } #zone-bar::-webkit-scrollbar-thumb { background:rgba(255,255,255,.1); border-radius:2px; }
  </style>
</head>
<body>
  <div id="topbar">
    <div class="topbar-title"><span class="icon">&#x1F4F9;</span><span>CCTV Control Centre</span></div>
    <div class="sensor-stats">
      <span class="sensor-pill online"><span id="stat-online">&mdash;</span> Online</span>
      <span class="sensor-pill stale"><span id="stat-stale">&mdash;</span> Stale</span>
      <span class="sensor-pill offline"><span id="stat-offline">&mdash;</span> Offline</span>
      <span class="sensor-pill" style="background:rgba(239,68,68,.08);color:#f87171;display:none" id="stat-broken-wrap"><span id="stat-broken">0</span> Broken</span>
      <div class="health-bar"><div class="health-bar-fill" id="health-fill" style="width:0%"></div></div>
    </div>
    <div class="vision-summary" id="vision-summary"></div>
    <div class="topbar-right">
      <input type="text" id="search-input" placeholder="Search cameras..." autocomplete="off">
      <button class="grid-btn" data-cols="2" title="2x2">&#x229E; 2</button>
      <button class="grid-btn" data-cols="4" title="4x4">&#x229E; 4</button>
      <button class="grid-btn" data-cols="6" title="6x6">&#x229E; 6</button>
      <button class="grid-btn active" data-cols="8" title="8x8">&#x229E; 8</button>
      <span id="last-fetch">&mdash;</span>
    </div>
  </div>
  <div id="zone-bar"></div>
  <div id="vision-alerts"><span style="font-weight:700">&#9888; Vision Alerts</span><span id="alert-items"></span><span class="alert-dismiss" onclick="dismissAlerts()">&times;</span></div>
  <div id="minimap-wrap"><div id="minimap"></div></div>
  <div id="camera-grid"></div>
  <div id="lightbox">
    <span class="lb-close" onclick="closeLightbox()">&times;</span>
    <div class="lb-content">
      <img class="lb-img" id="lb-img" src="" alt="">
      <div class="lb-info"><span class="lb-name" id="lb-name"></span><span class="lb-meta" id="lb-meta"></span></div>
      <div class="lb-vision" id="lb-vision">
        <div class="lb-vision-title">Vision Analysis</div>
        <div class="lb-vision-grid" id="lb-vision-grid"></div>
      </div>
      <div class="lb-incidents" id="lb-incidents"></div>
      <div class="lb-scene-desc" id="lb-scene-desc" style="display:none"><div class="label">AI Scene Description</div><div id="lb-desc-text"></div></div>
      <div class="lb-nav">
        <button class="lb-nav-btn" onclick="lbNav(-1)">&#9664; Previous</button>
        <button class="lb-nav-btn" onclick="lbRefresh()">&#8635; Refresh</button>
        <button class="lb-nav-btn" onclick="lbNav(1)">Next &#9654;</button>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/gh/WispAyr/wispayr-design@main/js/wispayr.js"></script>
  <script>if (window.WispAyr) WispAyr.init('traffic');</script>
  <script>
    const ZONES=[
      {id:'all',label:'All Cameras',icon:'\u{1F4E1}',match:()=>true},
      {id:'gla-centre',label:'Glasgow Centre',icon:'\u{1F3D9}',match:s=>s.lat>=55.84&&s.lat<=55.89&&s.lon>=-4.30&&s.lon<=-4.22},
      {id:'gla-west',label:'Glasgow West / Airport',icon:'\u2708\uFE0F',match:s=>s.lat>=55.84&&s.lat<=55.90&&s.lon>=-4.50&&s.lon<-4.30},
      {id:'gla-east',label:'Glasgow East',icon:'\u{1F3ED}',match:s=>s.lat>=55.83&&s.lat<=55.90&&s.lon>=-4.22&&s.lon<=-4.10},
      {id:'gla-south',label:'Glasgow South / M77',icon:'\u{1F6E3}\uFE0F',match:s=>s.lat>=55.78&&s.lat<55.84&&s.lon>=-4.36&&s.lon<=-4.18},
      {id:'east-ren',label:'East Renfrewshire',icon:'\u{1F33F}',match:s=>s.lat>=55.74&&s.lat<55.80&&s.lon>=-4.40&&s.lon<=-4.20},
      {id:'kilmarnock',label:'Kilmarnock / A77',icon:'\u{1F504}',match:s=>s.lat>=55.62&&s.lat<55.74&&s.lon>=-4.50&&s.lon<=-4.25},
      {id:'south-ayr',label:'South Ayrshire',icon:'\u{1F3F4}',match:s=>s.lat<55.55&&s.lon<=-4.10},
      {id:'coast',label:'Ayrshire Coast',icon:'\u{1F30A}',match:s=>s.lat>=55.55&&s.lat<55.75&&s.lon<-4.50},
    ];
    const ZONE_GRID={'all':8,'gla-centre':4,'gla-west':4,'gla-east':4,'gla-south':3,'east-ren':3,'kilmarnock':2,'south-ayr':2,'coast':2};
    const WEATHER_ICONS={'sunny':'\u2600\uFE0F','clear_sky':'\u2600\uFE0F','bright':'\u2600\uFE0F','overcast':'\u2601\uFE0F','mixed':'\u26C5','dark':'\u{1F311}','fog':'\u{1F32B}\uFE0F','rain':'\u{1F327}\uFE0F'};
    const TOD_ICONS={'night':'\u{1F319}','dusk':'\u{1F305}','overcast':'\u2601\uFE0F','daylight':'\u2600\uFE0F','bright':'\u{1F506}'};
    const ACTIVITY_LABELS={'frozen':'\u2744 Frozen','static':'\u23F8 Static','light':'Light','moderate':'Moderate','heavy':'\u26A0 Heavy'};
    const RT_ICONS={motorway:'\u{1F6E3}\uFE0F',dual_carriageway:'\u{1F6E4}\uFE0F',single_carriageway:'',complex:'\u{1F500}'};
    const RT_CSS={motorway:'road-motorway',dual_carriageway:'road-dual',single_carriageway:'road-single',complex:'road-complex'};
    const RT_LABELS={motorway:'\u{1F6E3}\uFE0F Motorway',dual_carriageway:'\u{1F6E4}\uFE0F Dual Carriageway',single_carriageway:'Single Carriageway',complex:'\u{1F500} Complex / Junction'};
    const DENSITY_CSS={empty:'empty',light:'light',moderate:'moderate',heavy:'heavy',congested:'congested'};
    const DENSITY_ICONS={empty:'',light:'\u{1F698}',moderate:'\u{1F697}',heavy:'\u{1F6A8}',congested:'\u{1F6A8}'};
    const INCIDENT_ICONS={potential_collision:'\u{1F4A5}',possible_queue:'\u{1F6A6}',hard_shoulder_use:'\u26A0',pedestrian_on_carriageway:'\u{1F6B6}',workers_on_road:'\u{1F477}'};
    const INCIDENT_LABELS={potential_collision:'Collision',possible_queue:'Queue',hard_shoulder_use:'Hard Shoulder',pedestrian_on_carriageway:'Pedestrian',workers_on_road:'Workers'};

    let allSensors=[], filteredSensors=[], currentLbIndex=-1, autoRefreshTimer=null, activeZone='all';
    let visionData={}, visionSummary=null, visionAlerts=[], alertsDismissed=false;
    let incidentData={}, sceneDescriptions={};

    const grid=document.getElementById('camera-grid');
    const searchInput=document.getElementById('search-input');
    const gridBtns=document.querySelectorAll('.grid-btn');
    const zoneBar=document.getElementById('zone-bar');

    function setGridCols(n){document.documentElement.style.setProperty('--grid-cols',n);gridBtns.forEach(b=>{b.classList.toggle('active',parseInt(b.dataset.cols)===n)});}
    gridBtns.forEach(btn=>{btn.addEventListener('click',()=>{setGridCols(parseInt(btn.dataset.cols));});});

    function renderZoneBar(){
      zoneBar.innerHTML=ZONES.map(z=>{
        const count=z.id==='all'?allSensors.length:allSensors.filter(s=>z.match(s)).length;
        if(count===0&&z.id!=='all')return '';
        return `<button class="zone-btn ${z.id===activeZone?'active':''}" data-zone="${z.id}">${z.icon} ${z.label} <span class="zone-count">${count}</span></button>`;
      }).join('');
      zoneBar.querySelectorAll('.zone-btn').forEach(btn=>{
        btn.addEventListener('click',()=>{activeZone=btn.dataset.zone;setGridCols(ZONE_GRID[activeZone]||4);applyFilters();renderZoneBar();});
      });
    }

    function applyFilters(){
      const q=searchInput.value.toLowerCase().trim();
      const zone=ZONES.find(z=>z.id===activeZone)||ZONES[0];
      filteredSensors=allSensors.filter(s=>{
        if(!zone.match(s))return false;
        if(q&&!(s.name.toLowerCase().includes(q)||s.sensor_id.toLowerCase().includes(q)))return false;
        return true;
      });
      renderGrid();
    }
    searchInput.addEventListener('input',()=>applyFilters());

    document.addEventListener('keydown',e=>{
      if(e.key==='Escape')closeLightbox();
      if(document.getElementById('lightbox').classList.contains('open')){
        if(e.key==='ArrowLeft')lbNav(-1);
        if(e.key==='ArrowRight')lbNav(1);
        if(e.key==='r')lbRefresh();
      }
      if(e.key==='/'&&!e.ctrlKey&&!e.metaKey&&document.activeElement!==searchInput){e.preventDefault();searchInput.focus();}
    });

    async function fetchSensors(){
      try{
        const resp=await fetch('/api/cameras/sensors');
        const data=await resp.json();
        document.getElementById('stat-online').textContent=data.online||0;
        document.getElementById('stat-stale').textContent=data.stale||0;
        document.getElementById('stat-offline').textContent=data.offline||0;
        document.getElementById('health-fill').style.width=(data.health_pct||0)+'%';
        const hpct=data.health_pct||0;
        document.getElementById('health-fill').style.background=hpct>80?'#22c55e':hpct>50?'#f59e0b':'#ef4444';
        if(data.last_image_fetch){document.getElementById('last-fetch').textContent='Last pull: '+new Date(data.last_image_fetch).toLocaleTimeString('en-GB');}
        allSensors=(data.sensors||[]).sort((a,b)=>{const o={live:0,stale:1,offline:2};const d=(o[a.status]||2)-(o[b.status]||2);return d!==0?d:a.name.localeCompare(b.name);});
        renderZoneBar();applyFilters();
      }catch(err){console.error('Sensor fetch failed:',err);}
    }

    function formatAge(s){if(!s&&s!==0)return'\u2014';if(s<60)return Math.round(s)+'s ago';if(s<3600)return Math.round(s/60)+'m ago';return Math.round(s/3600)+'h ago';}

    function getVisionBadges(sensorId){
      const v=visionData[sensorId];
      if(!v)return '';
      const parts=[];
      // Road type
      const rt=v.road_type;
      if(rt&&rt.road_type&&rt.road_type!=='unknown'){
        const cls=RT_CSS[rt.road_type]||'';
        const ico=RT_ICONS[rt.road_type]||'';
        parts.push(`<span class="vision-road-type ${cls}">${ico}${rt.lane_estimate}L</span>`);
      }
      // Weather
      const w=v.weather&&v.weather.weather;
      if(w){parts.push(`<span class="vision-badge vision-weather">${WEATHER_ICONS[w]||''}</span>`);}
      // Activity
      const act=v.activity&&v.activity.activity_level;
      if(act&&act!=='unknown'&&act!=='broken'){parts.push(`<span class="vision-badge vision-activity ${act}">${act}</span>`);}
      // Fog
      const fog=v.brightness&&v.brightness.fog_likelihood;
      if(fog&&fog>30){parts.push(`<span class="vision-badge vision-fog">\u{1F32B} ${fog}%</span>`);}
      // Rain
      if(v.rain&&v.rain.rain_detected){parts.push(`<span class="vision-badge vision-rain">\u{1F327}</span>`);}
      // Broken
      if(v.broken&&v.broken.broken){parts.push(`<span class="vision-badge vision-broken">\u26D4</span>`);}
      // Vehicles
      const vh=v.vehicles;
      if(vh&&vh.total_vehicles>0){
        const dc=DENSITY_CSS[vh.density]||'light';
        parts.push(`<span class="vision-vehicles ${dc}">${vh.total_vehicles}\u{1F697}</span>`);
      }
      // Incidents
      const incs=incidentData[sensorId];
      if(incs&&incs.length>0){
        const worst=incs.find(i=>i.severity==='critical')||incs[0];
        const ico=INCIDENT_ICONS[worst.type]||'\u26A0';
        parts.push(`<span class="vision-incident">${ico}${incs.length>1?incs.length:''}</span>`);
      }
      return parts.length?`<div class="cam-vision">${parts.join('')}</div>`:'';
    }

    function renderGrid(){
      if(filteredSensors.length===0&&allSensors.length>0){grid.innerHTML='<div class="no-results">No cameras match your filters</div>';return;}
      if(filteredSensors.length===0){grid.innerHTML='';for(let i=0;i<16;i++)grid.innerHTML+='<div class="cam-tile loading"></div>';return;}
      const bust=Math.floor(Date.now()/60000);
      grid.innerHTML=filteredSensors.map((s,idx)=>{
        const sc=s.status||'offline', sl=s.status==='live'?'LIVE':s.status==='stale'?'STALE':'OFFLINE';
        const off=s.status==='offline', src=off?'':s.image_url+'?t='+bust, age=formatAge(s.last_image_age_seconds);
        const v=visionData[s.sensor_id], isBroken=v&&v.broken&&v.broken.broken;
        const tileClass=isBroken?'broken':(off?'offline':'');
        const brokenOv=isBroken?`<div class="broken-overlay"><span class="broken-label">\u26D4 ${(v.broken.reason||'').replace(/_/g,' ')}</span></div>`:'';
        return `<div class="cam-tile ${tileClass}" onclick="openLightbox(${idx})" data-idx="${idx}">
          ${src?`<img src="${src}" alt="${s.name}" loading="lazy" onerror="this.style.display='none'">`:''}
          ${brokenOv}
          <div class="cam-topbar"><span class="cam-id">${s.sensor_id}</span><span class="cam-age">${age}</span></div>
          ${getVisionBadges(s.sensor_id)}
          <div class="cam-overlay"><span class="cam-name">${s.name}</span><span class="cam-status ${sc}"><span class="cam-status-dot"></span>${sl}</span></div>
        </div>`;
      }).join('');
    }

    function openLightbox(idx){
      if(idx<0||idx>=filteredSensors.length)return;
      currentLbIndex=idx;const s=filteredSensors[idx];
      const lb=document.getElementById('lightbox'),img=document.getElementById('lb-img'),nm=document.getElementById('lb-name'),mt=document.getElementById('lb-meta');
      img.src=s.image_url+'?t='+Date.now();nm.textContent=s.name;
      const age=formatAge(s.last_image_age_seconds);
      const sl=s.status==='live'?'\u{1F7E2} LIVE':s.status==='stale'?'\u{1F7E1} STALE':'\u{1F534} OFFLINE';
      mt.textContent=sl+'  \u2022  '+age+'  \u2022  '+s.sensor_id;
      renderLbVision(s.sensor_id);
      lb.classList.add('open');
      clearInterval(autoRefreshTimer);autoRefreshTimer=setInterval(()=>{img.src=s.image_url+'?t='+Date.now();},30000);
    }
    function closeLightbox(){document.getElementById('lightbox').classList.remove('open');clearInterval(autoRefreshTimer);currentLbIndex=-1;}
    function lbNav(dir){if(currentLbIndex<0)return;const n=currentLbIndex+dir;if(n>=0&&n<filteredSensors.length)openLightbox(n);}
    function lbRefresh(){if(currentLbIndex<0)return;document.getElementById('lb-img').src=filteredSensors[currentLbIndex].image_url+'?t='+Date.now();}
    document.getElementById('lightbox').addEventListener('click',e=>{if(e.target.id==='lightbox')closeLightbox();});

    function renderLbVision(sensorId){
      const panel=document.getElementById('lb-vision'),g=document.getElementById('lb-vision-grid');
      if(!panel||!g)return;
      const v=visionData[sensorId];
      if(!v){panel.classList.remove('visible');return;}
      const w=v.weather&&v.weather.weather||'\u2014', wI=WEATHER_ICONS[w]||'';
      const tod=v.brightness&&v.brightness.time_of_day||'\u2014', todI=TOD_ICONS[tod]||'';
      const act=v.activity&&v.activity.activity_level||'\u2014', actL=ACTIVITY_LABELS[act]||act;
      const fog=v.brightness?v.brightness.fog_likelihood:'\u2014';
      const bri=v.brightness&&v.brightness.mean_brightness?Math.round(v.brightness.mean_brightness):'\u2014';
      const sc=v.activity?v.activity.scene_change_pct:'\u2014';
      const wet=v.weather?v.weather.wet_road_score:'\u2014';
      const at=v.analysed_at?new Date(v.analysed_at).toLocaleTimeString('en-GB'):'\u2014';
      const rain=v.rain||{}, rs=rain.rain_score!=null?rain.rain_score:'\u2014', lc=rain.lens_condition||'\u2014';
      const vh=v.vehicles||{total_vehicles:0,density:'',vehicles:{},persons:0};
      const brk=v.broken||{}, bs=brk.broken?('\u26D4 '+(brk.reason||'').replace(/_/g,' ')):'\u2705 OK';
      const rt=v.road_type||{}, rtL=RT_LABELS[rt.road_type]||rt.road_type||'\u2014', rtD=rt.road_detail||'', rtC=rt.confidence||0;
      g.innerHTML=`
        <div class="lb-vision-stat"><span class="label">Camera</span><span class="value" style="${brk.broken?'color:#f87171':''}">${bs}</span></div>
        <div class="lb-vision-stat"><span class="label">Road Type</span><span class="value">${rtL}</span></div>
        <div class="lb-vision-stat"><span class="label">Detail</span><span class="value">${rtD} (${rtC}%)</span></div>
        <div class="lb-vision-stat"><span class="label">Weather</span><span class="value">${wI} ${w}</span></div>
        <div class="lb-vision-stat"><span class="label">Time</span><span class="value">${todI} ${tod}</span></div>
        <div class="lb-vision-stat"><span class="label">Activity</span><span class="value">${actL}</span></div>
        <div class="lb-vision-stat"><span class="label">Lens</span><span class="value">${lc} (${rs}/100)</span></div>
        <div class="lb-vision-stat"><span class="label">Fog</span><span class="value">${fog}%</span></div>
        <div class="lb-vision-stat"><span class="label">Brightness</span><span class="value">${bri}</span></div>
        <div class="lb-vision-stat"><span class="label">Scene Change</span><span class="value">${sc}%</span></div>
        <div class="lb-vision-stat"><span class="label">Wet Road</span><span class="value">${wet}</span></div>
        <div class="lb-vision-stat"><span class="label">Vehicles</span><span class="value" style="${vh.total_vehicles>8?'color:#f87171':vh.total_vehicles>3?'color:#fbbf24':'color:#4ade80'}">${vh.total_vehicles} ${vh.density||''}</span></div>
        <div class="lb-vision-stat"><span class="label">Cars</span><span class="value">${vh.vehicles&&vh.vehicles.car||0}</span></div>
        <div class="lb-vision-stat"><span class="label">Trucks</span><span class="value">${vh.vehicles&&vh.vehicles.truck||0}</span></div>
        <div class="lb-vision-stat"><span class="label">Buses</span><span class="value">${vh.vehicles&&vh.vehicles.bus||0}</span></div>
        <div class="lb-vision-stat"><span class="label">Persons</span><span class="value">${vh.persons||0}</span></div>
        <div class="lb-vision-stat"><span class="label">Analysed</span><span class="value">${at}</span></div>`;
      panel.classList.add('visible');
      // Incidents
      const incPanel=document.getElementById('lb-incidents');
      const incs=incidentData[sensorId]||[];
      if(incPanel){
        if(incs.length>0){
          incPanel.innerHTML=incs.map(i=>{
            const ico=INCIDENT_ICONS[i.type]||'\u26A0';
            const lbl=INCIDENT_LABELS[i.type]||i.type.replace(/_/g,' ');
            return `<span class="lb-incident-item ${i.severity}">${ico} ${lbl}: ${i.message}</span>`;
          }).join('');
          incPanel.style.display='';
        } else { incPanel.style.display='none'; incPanel.innerHTML=''; }
      }
      // Scene description
      const descPanel=document.getElementById('lb-scene-desc'),descText=document.getElementById('lb-desc-text');
      const desc=sceneDescriptions[sensorId];
      if(descPanel&&descText){
        if(desc&&!desc.startsWith('The user')){descText.textContent=desc;descPanel.style.display='';}
        else{descPanel.style.display='none';}
      }
    }

    function refreshGridImages(){const b=Date.now();document.querySelectorAll('.cam-tile img').forEach(i=>{i.src=i.src.split('?')[0]+'?t='+b;});}

    // Mini Map
    const minimap=L.map('minimap',{zoomControl:false,attributionControl:false,dragging:false,scrollWheelZoom:false,doubleClickZoom:false,touchZoom:false}).setView([55.55,-4.5],9);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{maxZoom:16}).addTo(minimap);
    let minimapMarkers=L.layerGroup().addTo(minimap);
    function updateMinimap(){
      minimapMarkers.clearLayers();if(filteredSensors.length===0)return;
      const bounds=[];
      filteredSensors.forEach(s=>{
        const c=s.status==='live'?'#22c55e':s.status==='stale'?'#f59e0b':'#ef4444';
        const m=L.circleMarker([s.lat,s.lon],{radius:4,fillColor:c,color:c,weight:1,opacity:.9,fillOpacity:.8});
        m.bindTooltip(s.name,{direction:'top',offset:[0,-6]});minimapMarkers.addLayer(m);bounds.push([s.lat,s.lon]);
      });
      if(bounds.length>1)minimap.fitBounds(bounds,{padding:[15,15],maxZoom:13});
      else if(bounds.length===1)minimap.setView(bounds[0],12);
    }
    const _origAF=applyFilters;applyFilters=function(){_origAF();updateMinimap();};

    // Vision
    async function fetchVisionData(){
      try{
        const [aR,alR,incR]=await Promise.all([fetch('/api/vision'),fetch('/api/vision/alerts'),fetch('/api/vision/incidents')]);
        const aJ=await aR.json(), alJ=await alR.json();
        visionSummary=aJ.summary||null; visionAlerts=alJ.alerts||[];
        visionData={};for(const[sid,cam]of Object.entries(aJ.cameras||{}))visionData[sid]=cam;
        try{const incJ=await incR.json();incidentData=incJ.incidents||{};sceneDescriptions=incJ.descriptions||{};}catch(e){}
        updateVisionSummary();updateAlertBanner();renderGrid();
      }catch(e){console.warn('Vision fetch failed:',e);}
    }

    function updateVisionSummary(){
      const el=document.getElementById('vision-summary');if(!visionSummary||!el)return;
      const w=visionSummary.dominant_weather||'\u2014', wI=WEATHER_ICONS[w]||'', frozen=visionSummary.frozen_cameras||0, n=visionSummary.total_analysed||0;
      let cc='#4ade80',cl='Normal';if(frozen>n*.3){cc='#f87171';cl='Degraded';}else if(frozen>n*.1){cc='#fbbf24';cl='Fair';}
      const rain=visionSummary.rain_detected_cameras||0, broken=visionSummary.broken_cameras||0, rt=visionSummary.road_types||{};
      let ep='';
      if(rt.motorway)ep+=`<span class="vision-pill" style="color:#f87171">\u{1F6E3}\uFE0F ${rt.motorway} motorway</span>`;
      if(rt.dual_carriageway)ep+=`<span class="vision-pill" style="color:#fbbf24">\u{1F6E4}\uFE0F ${rt.dual_carriageway} dual</span>`;
      if(rt.single_carriageway)ep+=`<span class="vision-pill" style="color:#4ade80">${rt.single_carriageway} single</span>`;
      if(rt.complex)ep+=`<span class="vision-pill" style="color:#c084fc">\u{1F500} ${rt.complex} complex</span>`;
      if(broken>0)ep+=`<span class="vision-pill" style="color:#f87171">\u26D4 ${broken} broken</span>`;
      if(rain>0)ep+=`<span class="vision-pill" style="color:#60a5fa">\u{1F327} ${rain} rain</span>`;
      const totalV=visionSummary.total_vehicles||0,camV=visionSummary.cameras_with_vehicles||0;
      const vTypes=visionSummary.vehicle_types||{};
      let vp='';
      if(totalV>0){
        const vc=totalV>100?'#f87171':totalV>50?'#fbbf24':'#4ade80';
        vp=`<span class="vision-pill" style="color:${vc}">\u{1F698} ${totalV} vehicles (${camV} cams)</span>`;
        const parts=Object.entries(vTypes).map(([t,c])=>c+' '+t+(c>1?'s':'')).join(', ');
        if(parts)vp+=`<span class="vision-pill">${parts}</span>`;
      }
      const bEl=document.getElementById('stat-broken'),bW=document.getElementById('stat-broken-wrap');
      if(bEl)bEl.textContent=broken;if(bW)bW.style.display=broken>0?'':'none';
      // Incident summary
      const totalIncs=Object.values(incidentData).reduce((s,a)=>s+(a?a.length:0),0);
      const incPill=totalIncs>0?`<span class="vision-pill" style="color:#f87171">\u26A0 ${totalIncs} incidents</span>`:'';
      el.innerHTML=`<span class="vision-pill">${wI} ${w.charAt(0).toUpperCase()+w.slice(1)}</span><span class="vision-pill" style="color:${cc}">${cl}</span>${ep}${vp}${incPill}<span class="vision-pill">${n} analysed</span>`;
    }

    function updateAlertBanner(){
      const wrap=document.getElementById('vision-alerts'),items=document.getElementById('alert-items');
      if(!wrap||!items)return;
      if(alertsDismissed||visionAlerts.length===0){wrap.classList.remove('visible');return;}
      const groups={};visionAlerts.forEach(a=>{(a.alerts||[]).forEach(al=>{const t=al.type||'unknown';if(!groups[t])groups[t]=[];groups[t].push(a.sensor_id);});});
      // Add traffic incidents to alert groups
      for(const[sid,incs]of Object.entries(incidentData)){
        (incs||[]).forEach(inc=>{
          const t=inc.type||'unknown';
          if(!groups[t])groups[t]=[];
          if(!groups[t].includes(sid))groups[t].push(sid);
        });
      }
      const tm={frozen:{c:'frozen',i:'\u2744'},fog:{c:'fog',i:'\u{1F32B}\uFE0F'},congestion:{c:'congestion',i:'\u{1F697}'},rain_on_lens:{c:'rain_on_lens',i:'\u{1F327}'},broken_camera:{c:'broken_camera',i:'\u26D4'},wet_road:{c:'congestion',i:'\u{1F4A7}'},potential_collision:{c:'congestion',i:'\u{1F4A5}'},possible_queue:{c:'congestion',i:'\u{1F6A6}'},hard_shoulder_use:{c:'congestion',i:'\u26A0'},pedestrian_on_carriageway:{c:'congestion',i:'\u{1F6B6}'},workers_on_road:{c:'congestion',i:'\u{1F477}'}};
      items.innerHTML=Object.entries(groups).map(([t,ids])=>{const m=tm[t]||{c:'',i:'\u26A0'};return `<span class="alert-item ${m.c}">${m.i} ${ids.length} ${t.replace(/_/g,' ')}</span>`;}).join('');
      wrap.classList.add('visible');
    }
    function dismissAlerts(){alertsDismissed=true;document.getElementById('vision-alerts').classList.remove('visible');}

    // Init
    fetchSensors();fetchVisionData();
    setInterval(fetchSensors,60000);setInterval(fetchVisionData,60000);setInterval(refreshGridImages,120000);
  </script>
</body>
</html>
