<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AyrTraffic — Live Ayrshire Traffic</title>

  <!-- WispAyr Design System -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/WispAyr/wispayr-design@main/css/wispayr.css">

  <!-- Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Leaflet Heat -->
  <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>

  <style>
    /* ── App-Specific Overrides ── */
    :root {
      --status-height: 40px;
    }

    /* Kill default body scroll — full-screen map app */
    body {
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Header adjustments for map app */
    .w-header { flex-shrink: 0; }
    .w-footer { display: none; } /* No footer in map app */

    /* ── Status Strip ── */
    #statusbar {
      height: var(--status-height);
      background: var(--w-bg-card);
      border-bottom: 1px solid var(--w-border);
      display: flex;
      align-items: center;
      padding: 0 16px;
      gap: 16px;
      flex-shrink: 0;
      z-index: 999;
      transition: background var(--w-transition), border var(--w-transition);
    }

    .status-pills {
      display: flex;
      gap: 10px;
      flex: 1;
      overflow: hidden;
    }

    .pill {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      transition: background var(--w-transition), color var(--w-transition);
    }

    .pill .count { font-weight: 700; }
    .pill.red   { background: var(--w-bg-red);    }
    .pill.red .count   { color: var(--w-red); }
    .pill.amber { background: var(--w-bg-orange); }
    .pill.amber .count { color: var(--w-orange); }
    .pill.green { background: var(--w-bg-green);  }
    .pill.green .count { color: var(--w-green); }
    .pill.blue  { background: var(--w-bg-blue);   }
    .pill.blue .count  { color: var(--w-blue); }

    #conn-status {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--w-text-muted);
      white-space: nowrap;
      margin-left: auto;
    }

    #conn-status .indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--w-green);
      transition: background var(--w-transition);
    }

    #conn-status.offline .indicator { background: var(--w-red); }
    #conn-status.loading .indicator { background: var(--w-orange); animation: pulse 1s infinite; }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    #last-updated {
      font-size: 11px;
      color: var(--w-text-light);
      white-space: nowrap;
    }

    /* ── Main Layout ── */
    #main {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* ── Sidebar ── */
    #sidebar {
      width: 300px;
      min-width: 260px;
      background: var(--w-bg-card);
      border-right: 1px solid var(--w-border);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      z-index: 100;
      transition: width 0.2s ease, background var(--w-transition), border var(--w-transition);
    }

    #sidebar.collapsed { width: 0; min-width: 0; overflow: hidden; }

    .sidebar-header {
      padding: 14px 16px;
      border-bottom: 1px solid var(--w-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: border var(--w-transition);
    }

    .sidebar-header h2 {
      font-size: 13px;
      font-weight: 600;
      color: var(--w-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* ── Layer Toggles ── */
    .layer-toggles {
      padding: 12px 16px;
      border-bottom: 1px solid var(--w-border);
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: border var(--w-transition);
    }

    .layer-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: var(--w-radius-xs);
      background: transparent;
      border: 1px solid transparent;
      transition: all var(--w-transition);
    }

    .layer-toggle:hover { background: var(--w-bg-elevated); }
    .layer-toggle.active { border-color: var(--w-blue); background: var(--w-bg-blue); }

    .layer-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 500;
      color: var(--w-text);
    }

    .layer-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .toggle-switch {
      width: 34px;
      height: 18px;
      border-radius: 9px;
      background: var(--w-border);
      position: relative;
      transition: background 0.2s;
    }

    .toggle-switch::after {
      content: '';
      position: absolute;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: white;
      top: 2px;
      left: 2px;
      transition: left 0.2s;
    }

    .layer-toggle.active .toggle-switch { background: var(--w-blue); }
    .layer-toggle.active .toggle-switch::after { left: 18px; }

    /* ── Search ── */
    .search-box {
      padding: 12px 16px;
      border-bottom: 1px solid var(--w-border);
      transition: border var(--w-transition);
    }

    .search-box input {
      width: 100%;
      background: var(--w-bg-elevated);
      border: 1px solid var(--w-border);
      border-radius: var(--w-radius-xs);
      padding: 8px 12px;
      color: var(--w-text);
      font-size: 13px;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: border var(--w-transition), background var(--w-transition), color var(--w-transition);
    }

    .search-box input:focus { border-color: var(--w-blue); }
    .search-box input::placeholder { color: var(--w-text-light); }

    /* ── Incident List ── */
    #incident-list {
      flex: 1;
      overflow-y: auto;
      padding: 8px;
    }

    #incident-list::-webkit-scrollbar { width: 4px; }
    #incident-list::-webkit-scrollbar-track { background: transparent; }
    #incident-list::-webkit-scrollbar-thumb { background: var(--w-border); border-radius: 2px; }

    .incident-card {
      padding: 10px 12px;
      border-radius: var(--w-radius-sm);
      background: var(--w-bg-elevated);
      border: 1px solid var(--w-border);
      margin-bottom: 6px;
      cursor: pointer;
      transition: border-color var(--w-transition), background var(--w-transition), box-shadow var(--w-transition);
    }

    .incident-card:hover {
      border-color: var(--w-blue);
      background: var(--w-bg-blue);
      box-shadow: var(--w-shadow-sm);
    }

    .incident-card-header {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 4px;
    }

    .severity-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 4px;
    }

    .incident-title {
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
      color: var(--w-text);
    }

    .incident-meta {
      font-size: 11px;
      color: var(--w-text-muted);
      margin-left: 16px;
    }

    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .badge-incident  { background: var(--w-bg-red);    color: var(--w-red); }
    .badge-roadworks { background: var(--w-bg-orange); color: var(--w-orange); }
    .badge-flow      { background: var(--w-bg-green);  color: var(--w-green); }
    .badge-tro       { background: var(--w-bg-purple); color: var(--w-purple); }
    .badge-ferry     { background: var(--w-bg-blue);   color: #06b6d4; }
    .badge-conditions { background: var(--w-bg-elevated); color: var(--w-text-muted); }

    .empty-state {
      text-align: center;
      padding: 40px 20px;
      color: var(--w-text-muted);
      font-size: 13px;
    }

    /* ── Map ── */
    #map-wrap {
      flex: 1;
      position: relative;
      overflow: hidden;
    }

    #map {
      width: 100%;
      height: 100%;
    }

    /* ── Map Controls ── */
    #map-controls {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .map-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--w-radius-xs);
      background: var(--w-bg-card);
      border: 1px solid var(--w-border);
      color: var(--w-text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: all var(--w-transition);
      box-shadow: var(--w-shadow-sm);
    }

    .map-btn:hover { background: var(--w-bg-blue); border-color: var(--w-blue); color: var(--w-blue); }
    .map-btn.active { background: var(--w-blue); border-color: var(--w-blue); color: white; }

    /* ── Sidebar Toggle ── */
    #sidebar-toggle {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 1001;
    }

    /* ── Legend ── */
    #legend {
      position: absolute;
      bottom: 30px;
      right: 12px;
      z-index: 1000;
      background: var(--w-bg-card);
      border: 1px solid var(--w-border);
      border-radius: var(--w-radius-sm);
      padding: 12px 14px;
      font-size: 12px;
      box-shadow: var(--w-shadow-md);
      transition: background var(--w-transition), border var(--w-transition);
    }

    .legend-title {
      font-weight: 600;
      color: var(--w-text-muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 5px;
      color: var(--w-text-muted);
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* ── Loading overlay ── */
    #loading {
      position: absolute;
      inset: 0;
      background: rgba(15,23,42,0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      flex-direction: column;
      gap: 16px;
      transition: background var(--w-transition);
    }

    [data-theme="light"] #loading { background: rgba(248,250,252,0.85); }

    #loading.hidden { display: none; }

    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid var(--w-border);
      border-top-color: var(--w-blue);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .loading-text {
      color: var(--w-text-muted);
      font-size: 14px;
      font-weight: 500;
    }

    /* ── Leaflet popup override ── */
    .leaflet-popup-content-wrapper {
      background: var(--w-bg-card) !important;
      border: 1px solid var(--w-border) !important;
      border-radius: var(--w-radius-sm) !important;
      box-shadow: var(--w-shadow-lg) !important;
      color: var(--w-text) !important;
    }

    .leaflet-popup-tip { background: var(--w-bg-card) !important; }

    .popup-title {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      line-height: 1.4;
      color: var(--w-text);
    }

    .popup-desc {
      font-size: 12px;
      color: var(--w-text-muted);
      margin-bottom: 8px;
      line-height: 1.5;
    }

    .popup-meta {
      font-size: 11px;
      color: var(--w-text-muted);
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .popup-source { color: var(--w-blue); }

    .popup-flow-data {
      margin-top: 8px;
      padding: 8px;
      background: var(--w-bg-elevated);
      border-radius: var(--w-radius-xs);
      font-size: 11px;
      color: var(--w-text-muted);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      /* Sidebar: overlay on mobile, starts collapsed */
      #sidebar {
        position: absolute;
        top: 0; left: 0; bottom: 0;
        z-index: 500;
        width: 280px;
        box-shadow: var(--w-shadow-lg);
      }
      #sidebar.collapsed { width: 0; min-width: 0; overflow: hidden; box-shadow: none; }

      /* Status bar: compact on mobile */
      #statusbar {
        padding: 0 10px;
        gap: 8px;
        height: 34px;
      }
      .status-pills { gap: 6px; }
      .pill { padding: 2px 7px; font-size: 10px; }
      .status-pills .pill:nth-child(n+4) { display: none; }
      #last-updated { display: none; }
      #conn-status { font-size: 10px; }

      /* Map fills viewport, account for bottom nav */
      #map-container { position: relative; }
      #map { height: 100% !important; }
      #main { margin-bottom: 52px; }

      /* Legend: hidden on mobile */
      #legend { display: none; }

      /* Layer toggles: bigger touch targets */
      .layer-toggle { padding: 10px 12px; min-height: 44px; }

      /* Map controls: adjust for mobile */
      #map-controls { top: 10px; right: 10px; }
      #sidebar-toggle { top: 10px; left: 10px; }

      /* Incident list: compact */
      .incident-card { padding: 10px; }
      .incident-card .title { font-size: 12px; }
      .incident-card .meta { font-size: 10px; }

      /* Bottom nav bar for mobile */
      #mobile-nav {
        display: flex !important;
      }

      /* WispAyr header: keep compact */
      .w-header { font-size: 14px; }
    }

    /* ── Bottom Mobile Nav ── */
    #mobile-nav {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 2000;
      background: var(--w-bg-card, #1e293b);
      border-top: 1px solid var(--w-border, #334155);
      padding: 6px 0;
      padding-bottom: max(6px, env(safe-area-inset-bottom));
      justify-content: space-around;
      align-items: center;
      box-shadow: 0 -2px 12px rgba(0,0,0,.3);
    }

    .mobile-nav-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 4px 12px;
      border: none;
      background: none;
      color: var(--w-text-muted, #94a3b8);
      font-size: 9px;
      font-weight: 600;
      cursor: pointer;
      transition: color .2s;
      text-decoration: none;
    }
    .mobile-nav-btn:hover, .mobile-nav-btn.active {
      color: var(--w-blue, #3b82f6);
    }
    .mobile-nav-btn .nav-icon {
      font-size: 20px;
      line-height: 1;
    }
  
    /* Fuel station markers */
    .camera-sensor-marker { background: none !important; border: none !important; }
    .fuel-marker { background: none !important; border: none !important; }
  
    /* VMS LED Screen Styles */
    .vms-marker {
      background: none !important;
      border: none !important;
    }
    .vms-screen {
      background: #111;
      border: 2px solid #333;
      border-radius: 4px;
      padding: 3px 6px;
      font-family: 'Courier New', monospace;
      font-size: 8px;
      font-weight: 700;
      color: #ffcc00;
      text-align: center;
      line-height: 1.15;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      white-space: nowrap;
      max-width: 120px;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 0 8px rgba(255,204,0,.4), inset 0 0 6px rgba(255,204,0,.08);
      text-shadow: 0 0 4px rgba(255,204,0,.6);
      position: relative;
    }
    .vms-screen::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,.15) 2px,
        rgba(0,0,0,.15) 3px
      );
      pointer-events: none;
      border-radius: 2px;
    }
    .vms-screen.inactive {
      color: #555;
      box-shadow: 0 0 4px rgba(0,0,0,.3);
      text-shadow: none;
    }
    .vms-popup-screen {
      background: #0a0a0a;
      border: 3px solid #2a2a2a;
      border-radius: 6px;
      padding: 14px 18px;
      font-family: 'Courier New', monospace;
      font-size: 15px;
      font-weight: 700;
      color: #ffcc00;
      text-align: center;
      line-height: 1.4;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin: 10px 0;
      box-shadow: 0 0 16px rgba(255,204,0,.3), inset 0 0 12px rgba(255,204,0,.05);
      text-shadow: 0 0 6px rgba(255,204,0,.5);
      position: relative;
      overflow: hidden;
    }
    .vms-popup-screen::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 3px,
        rgba(0,0,0,.12) 3px,
        rgba(0,0,0,.12) 4px
      );
      pointer-events: none;
    }
    .vms-popup-screen::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,.25) 100%);
      pointer-events: none;
    }
    .vms-popup-meta {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #9ca3af;
      margin-top: 8px;
    }
    .vms-popup-meta .vms-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: statusPulse 2s ease-in-out infinite;
    }
    .vms-popup-meta .vms-dot.off { background: #ef4444; animation: none; }

    /* VMS Wig-Wag Lights */
    .vms-marker { overflow: visible !important; }
    .vms-wrap {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .ww-light {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .ww-light.ww-amber { background: #ff8c00; }
    .ww-light.ww-red { background: #ef4444; }
    .ww-left {
      animation: wigwagLeft 0.7s ease-in-out infinite;
      margin-right: 4px;
    }
    .ww-left.ww-amber { box-shadow: 0 0 6px 3px rgba(255,140,0,.9), 0 0 14px 6px rgba(255,140,0,.5); }
    .ww-left.ww-red { box-shadow: 0 0 6px 3px rgba(239,68,68,.9), 0 0 14px 6px rgba(239,68,68,.5); }
    .ww-right {
      animation: wigwagRight 0.7s ease-in-out infinite;
      margin-left: 4px;
    }
    .ww-right.ww-amber { box-shadow: 0 0 6px 3px rgba(255,140,0,.9), 0 0 14px 6px rgba(255,140,0,.5); }
    .ww-right.ww-red { box-shadow: 0 0 6px 3px rgba(239,68,68,.9), 0 0 14px 6px rgba(239,68,68,.5); }
    @keyframes wigwagLeft {
      0%, 49% { opacity: 1; box-shadow: 0 0 6px 2px rgba(255,140,0,.9), 0 0 14px 6px rgba(255,140,0,.5); }
      50%, 100% { opacity: 0.1; box-shadow: none; }
    }
    @keyframes wigwagRight {
      0%, 49% { opacity: 0.1; box-shadow: none; }
      50%, 100% { opacity: 1; box-shadow: 0 0 6px 2px rgba(255,140,0,.9), 0 0 14px 6px rgba(255,140,0,.5); }
    }
    /* Popup wig-wag */
    .vms-popup-wigwag {
      position: relative;
      padding: 0 20px;
    }
    .vms-popup-wigwag .ww-pop-light {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #ff8c00;
    }
    .vms-popup-wigwag .ww-pop-left {
      left: 0;
      animation: wigwagLeft 0.8s ease-in-out infinite;
      box-shadow: 0 0 8px 3px rgba(255,140,0,.8), 0 0 18px 8px rgba(255,140,0,.4);
    }
    .vms-popup-wigwag .ww-pop-right {
      right: 0;
      animation: wigwagRight 0.8s ease-in-out infinite;
      box-shadow: 0 0 8px 3px rgba(255,140,0,.8), 0 0 18px 8px rgba(255,140,0,.4);
    }
    .vms-popup-wigwag .ww-pop-red {
      background: #ef4444;
      box-shadow: 0 0 8px 3px rgba(239,68,68,.8), 0 0 18px 8px rgba(239,68,68,.4) !important;
    }
  </style>
</head>
<body>

  <!-- WispAyr header is injected by wispayr.js -->

  <!-- Status Bar -->
  <div id="statusbar">
    <div class="status-pills">
      <div class="pill red">
        <span class="count" id="count-incidents">–</span>
        <span>Incidents</span>
      </div>
      <div class="pill amber">
        <span class="count" id="count-roadworks">–</span>
        <span>Roadworks</span>
      </div>
      <div class="pill blue">
        <span class="count" id="count-sources">–</span>
        <span>Sources</span>
      </div>
      <div class="pill blue">
        <span class="count" id="count-cameras">–</span>
        <span>Cameras</span>
      </div>
      <div class="pill blue" id="ferry-pill">
        <span class="count" id="count-ferries">–</span>
        <span>Ferries</span>
      </div>
      <div class="pill green" id="congestion-pill">
        <span class="count" id="count-congestion">–</span>
        <span>Congestion</span>
      </div>
    </div>
    <div id="last-updated">–</div>
    <div id="conn-status" class="loading">
      <span class="indicator"></span>
      <span id="conn-text">Connecting…</span>
