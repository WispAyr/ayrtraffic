<!-- WispAyr Design System JS -->
<script src="https://cdn.jsdelivr.net/gh/WispAyr/wispayr-design@main/js/wispayr.js"></script>

<script>
// ── WispAyr Init ────────────────────────────────────────────────────────────
// wispayr.js auto-inits, but we call explicitly with our app key
document.addEventListener('DOMContentLoaded', () => {
  if (window.WispAyr) WispAyr.init('traffic');
});

// ── Config ──────────────────────────────────────────────────────────────────
const AYR_CENTER = [55.4583, -4.6292];
const DEFAULT_ZOOM = 11;
const API_BASE = '';
const REFRESH_INTERVAL = 180000; // 3 min

// ── Map Init ─────────────────────────────────────────────────────────────────
const map = L.map('map', {
  center: AYR_CENTER,
  zoom: DEFAULT_ZOOM,
  zoomControl: false,
});

L.control.zoom({ position: 'bottomright' }).addTo(map);

// ── Tile Layers (dark/light) ─────────────────────────────────────────────────
const darkTile = L.tileLayer(
  'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
  { attribution: '© OpenStreetMap © CartoDB', maxZoom: 19 }
);
const lightTile = L.tileLayer(
  'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
  { attribution: '© OpenStreetMap © CartoDB', maxZoom: 19 }
);

// Sync map tiles with WispAyr theme
function syncMapTheme() {
  const theme = document.documentElement.getAttribute('data-theme');
  if (theme === 'dark') {
    if (map.hasLayer(lightTile)) map.removeLayer(lightTile);
    if (!map.hasLayer(darkTile)) darkTile.addTo(map);
  } else {
    if (map.hasLayer(darkTile)) map.removeLayer(darkTile);
    if (!map.hasLayer(lightTile)) lightTile.addTo(map);
  }
}

// Initial tile sync
syncMapTheme();

// Watch for WispAyr theme changes via MutationObserver
const themeObserver = new MutationObserver((mutations) => {
  for (const m of mutations) {
    if (m.attributeName === 'data-theme') {
      syncMapTheme();
    }
  }
});
themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

// Layer groups
const layers = {
  incidents: L.layerGroup().addTo(map),
  roadworks: L.layerGroup().addTo(map),
  flow:      L.layerGroup().addTo(map),
  tros:      L.layerGroup().addTo(map),
  ferries:   L.layerGroup().addTo(map),
  cameras:   L.layerGroup().addTo(map),
  vms:       L.layerGroup().addTo(map),
  fuel:      L.layerGroup(),
};

let heatLayer = null;

// -- TomTom Flow Tile Layer --
function buildFlowTileUrl() {
  return 'https://api.tomtom.com/traffic/map/4/tile/flow/relative0/{z}/{x}/{y}.png?key=KkNkcnBcWERbYBeSXUPV9DN1VWZOWbal&tileSize=256&t=' + Date.now();
}
let flowTileLayer = L.tileLayer(buildFlowTileUrl(), {
  opacity: 0.6,
  zIndex: 400,
  maxZoom: 19,
  attribution: '© TomTom'
}).addTo(map);

// Refresh flow tiles every 120 seconds
setInterval(() => {
  if (flowTileLayer && map.hasLayer(flowTileLayer)) {
    flowTileLayer.setUrl(buildFlowTileUrl());
  }
}, 120000);
let allItems = [];
let activeLayers = new Set(['incidents', 'roadworks', 'flow', 'flow-tiles', 'cameras', 'ferries', 'vms']);
let heatmapEnabled = false;

// ── Marker Icons ─────────────────────────────────────────────────────────────
function makeIcon(color, symbol) {
  return L.divIcon({
    className: '',
    html: `<div style="
      width:28px;height:28px;border-radius:50%;
      background:${color};
      border:2px solid rgba(255,255,255,0.3);
      display:flex;align-items:center;justify-content:center;
      font-size:13px;
      box-shadow:0 2px 8px rgba(0,0,0,0.5);
    ">${symbol}</div>`,
    iconSize: [28, 28],
    iconAnchor: [14, 14],
    popupAnchor: [0, -18],
  });
}

const ICONS = {
  red:    makeIcon('#ef4444', '⚠'),
  amber:  makeIcon('#f59e0b', '🚧'),
  green:  makeIcon('#22c55e', '✓'),
  purple: makeIcon('#8b5cf6', '🚫'),
  flow_red:   makeIcon('#ef4444', '🔴'),
  flow_amber: makeIcon('#f59e0b', '🟡'),
  flow_green: makeIcon('#22c55e', '🟢'),
  ferry:      makeIcon('#06b6d4', '⛴'),
  ferry_amber: makeIcon('#f59e0b', '⛴'),
  ferry_red:  makeIcon('#ef4444', '⛴'),
  camera: makeIcon('#3b82f6', '📷'),
};

// Stock VMS messages (safety reminders, not live warnings)
const VMS_STOCK_PATTERNS = [
  'PLEASE DRIVE SAFELY',
  'DONT DRIVE TIRED',
  'DRIVE EFFICIENTLY',
  'COURTEOUS DRIVER',
  'MIRRORS SIGNAL MANOEUVRE',
  'CHECK YOUR TYRE',
  'CHECK YOUR TREAD',
  'TYRE SAFETY',
  'SEATBELT',
  'SEAT BELT',
  'SAT-NAV',
  'SATNAV',
  'EYESIGHT',
  'WATCH YOUR SPEED',
  'DONT ADJUST',
  'DRINK AND DRIVE',
  'MOBILE PHONE',
];

function isVmsCaution(msg) {
  if (!msg) return false;
  const upper = msg.toUpperCase();
  // If it matches a stock pattern, it's NOT caution
  for (const pat of VMS_STOCK_PATTERNS) {
    if (upper.includes(pat)) return false;
  }
  // Caution keywords = live traffic info
  const cautionWords = ['QUEUE', 'CONGESTION', 'SLOW', 'CLOSED', 'ACCIDENT', 'INCIDENT',
    'DIVERSION', 'DELAY', 'WORKS', 'JOURNEY TIME', 'MAJOR', 'RESTRICT', 'BLOCKED',
    'CONTRAFLOW', 'LANE CLOSED', 'AVOID', 'FOG', 'ICE', 'FLOOD'];
  for (const w of cautionWords) {
    if (upper.includes(w)) return true;
  }
  return false;
}

function isVmsClosure(msg) {
  if (!msg) return false;
  const upper = msg.toUpperCase();
  const closureWords = ['CLOSED', 'CLOSURE', 'BLOCKED', 'ROAD CLOSED', 'AVOID', 'DO NOT USE'];
  for (const w of closureWords) {
    if (upper.includes(w)) return true;
  }
  return false;
}

function getIcon(item) {
  if (item.type === 'ferry') {
    if (item.severity === 'red') return ICONS.ferry_red;
    if (item.severity === 'amber') return ICONS.ferry_amber;
    return ICONS.ferry;
  }
  if (item.type === 'flow') {
    return ICONS['flow_' + item.severity] || ICONS.flow_green;
  }
  if (item.type === 'camera') {
    const sh = item.sensor_health || {};
    const fresh = sh.freshness || 'unknown';
    const dotColor = fresh === 'live' ? '#22c55e' : fresh === 'stale' ? '#f59e0b' : '#6b7280';
    return L.divIcon({
      className: 'camera-sensor-marker',
      html: '<div style="width:30px;height:30px;border-radius:50%;background:#1e3a5f;border:2px solid rgba(59,130,246,.6);display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,.5);position:relative">\U0001f4f7<div style="position:absolute;bottom:-2px;right:-2px;width:10px;height:10px;border-radius:50%;background:' + dotColor + ';border:2px solid #0f172a;box-shadow:0 0 4px ' + dotColor + '"></div></div>',
      iconSize: [30, 30],
      iconAnchor: [15, 15],
      popupAnchor: [0, -18],
    });
  }
  if (item.type === 'vms') {
    const msg = (item.vms_data && item.vms_data.message) || item.description || '';
    const working = item.vms_data ? item.vms_data.working : true;
    const shortMsg = msg.length > 20 ? msg.substring(0, 20) + '…' : msg;
    const caution = isVmsCaution(msg);
    const closure = isVmsClosure(msg);
    const lightClass = closure ? 'ww-red' : 'ww-amber';
    let markerHtml;
    if (caution) {
      markerHtml = '<div class="vms-wrap">' +
        '<div class="ww-light ww-left ' + lightClass + '"></div>' +
        '<div class="vms-screen">' + shortMsg + '</div>' +
        '<div class="ww-light ww-right ' + lightClass + '"></div>' +
        '</div>';
    } else {
      markerHtml = '<div class="vms-screen' + (working ? '' : ' inactive') + '">' + shortMsg + '</div>';
    }
    return L.divIcon({
      className: 'vms-marker',
      html: markerHtml,
      iconSize: [caution ? 168 : 140, 28],
      iconAnchor: [caution ? 84 : 70, 14],
      popupAnchor: [0, -18],
    });
  }
  if (item.severity === 'red')    return ICONS.red;
  if (item.severity === 'amber')  return ICONS.amber;
  if (item.severity === 'purple') return ICONS.purple;
  return ICONS.green;
}

// ── Popup Builder ─────────────────────────────────────────────────────────────
function buildPopup(item) {
  // VMS gets a special popup
  if (item.type === 'vms') {
    const vd = item.vms_data || {};
    const msg = vd.message || item.description || 'NO MESSAGE';
    const working = vd.working !== false;
    const timeSet = vd.time_set ? new Date(vd.time_set).toLocaleTimeString('en-GB', {hour:'2-digit',minute:'2-digit'}) : '';
    const road = vd.location_name || '';
    return `
      <div style="min-width:240px;max-width:320px;font-family:Inter,sans-serif;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:18px">📺</span>
          <div>
            <div style="font-weight:800;font-size:14px">Variable Message Sign</div>
            <div style="font-size:12px;color:#9ca3af">${road ? road + ' \u2022 ' : ''}${item.source}</div>
          </div>
        </div>
        <div class="${isVmsCaution(msg) ? 'vms-popup-wigwag' : ''}">${isVmsCaution(msg) ? '<div class="ww-pop-light ww-pop-left ' + (isVmsClosure(msg) ? 'ww-pop-red' : '') + '"></div><div class="ww-pop-light ww-pop-right ' + (isVmsClosure(msg) ? 'ww-pop-red' : '') + '"></div>' : ''}<div class="vms-popup-screen">${msg}</div></div>
        <div class="vms-popup-meta">
          <div class="vms-dot ${working ? '' : 'off'}"></div>
          <span>${working ? 'Active' : 'Inactive'}</span>
          ${timeSet ? '<span>\u2022 Set at ' + timeSet + '</span>' : ''}
          <span>\u2022 ID: ${vd.vms_id || '?'}</span>
        </div>
      </div>`;
  }

  const badgeClass = {
    incidents: 'badge-incident',
    roadworks: 'badge-roadworks',
    conditions: 'badge-roadworks',
    flow: 'badge-flow',
    tro: 'badge-tro',
    camera: 'badge-flow',
  }[item.type] || 'badge-roadworks';

  const badgeLabel = {
    incidents: 'Incident',
    roadworks: 'Roadworks',
    conditions: 'Road Condition',
    flow: 'Traffic Flow',
    tro: 'TRO',
    camera: 'Camera',
  }[item.type] || item.type;

  let extra = '';
  if (item.flow_data) {
    const fd = item.flow_data;
    extra = `
      <div class="popup-flow-data">
        <div>🚗 Speed: <strong>${fd.current_speed} km/h</strong> (free flow: ${fd.free_flow_speed})</div>
        <div>📊 Congestion: <strong>${Math.round(fd.congestion_level * 100)}%</strong></div>
        <div>🛣️ Route: ${fd.route}</div>
      </div>`;
  }

  if (item.camera_url) {
    const sh = item.sensor_health || {};
    const freshness = sh.freshness || 'unknown';
    const freshColor = freshness === 'live' ? '#22c55e' : freshness === 'stale' ? '#f59e0b' : '#ef4444';
    const freshLabel = freshness === 'live' ? '● LIVE' : freshness === 'stale' ? '● STALE' : '● OFFLINE';
    const sensorLine = sh.online !== undefined
      ? `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:11px;opacity:.85">
           <span style="color:${freshColor};font-weight:600">${freshLabel}</span>
           ${sh.last_image ? `<span>Updated: ${new Date(sh.last_image).toLocaleTimeString('en-GB')}</span>` : ''}
         </div>`
      : '';
    const imgUrl = item.camera_url + '?t=' + Math.floor(Date.now() / 60000);
    extra = `<div style="margin:8px 0">
      ${sensorLine}
      <img src="${imgUrl}" style="width:100%;border-radius:6px;border:1px solid rgba(255,255,255,.15);box-shadow:0 2px 8px rgba(0,0,0,.3)" onerror="this.style.display='none'" loading="lazy">
      ${item.source === 'Traffic Scotland FTP' ? '<div style="font-size:10px;opacity:.5;margin-top:4px;text-align:right">📡 FTP Sensor Feed</div>' : ''}
    </div>`;
  }

  if (item.ferry_data) {
    const fd = item.ferry_data;
    extra = `
      <div class="popup-flow-data">
        <div>⛴ Route: <strong>${fd.route_name}</strong></div>
        <div>🛥 Terminal: <strong>${fd.terminal}</strong></div>
        <div>📋 Status: <strong>${fd.overall_status}</strong></div>
        ${fd.disruption_count > 0 ? `<div>⚠ Active alerts: <strong>${fd.disruption_count}</strong></div>` : ''}
      </div>`;
  }

  const pubDate = item.pub_date ? `<div>🕐 ${new Date(item.pub_date).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'})}</div>` : '';
  const link = item.url ? `<a href="${item.url}" target="_blank" style="color:var(--w-blue);font-size:11px;">View source →</a>` : '';

  return `
    <div style="min-width:200px;max-width:280px;font-family:Inter,sans-serif;">
      <div class="popup-title">
        <span class="badge ${badgeClass}">${badgeLabel}</span>
        <br><br>${item.title}
      </div>
      <div class="popup-desc">${item.description || '–'}</div>
      ${extra}
      <div class="popup-meta">
        ${pubDate}
        <div class="popup-source">📡 ${item.source}</div>
        ${link}
      </div>
    </div>`;
}

// ── Render Markers ────────────────────────────────────────────────────────────
function renderMarkers(data) {
  Object.values(layers).forEach(l => l.clearLayers());

  const heatPoints = [];

  data.all.forEach(item => {
    if (!item.lat || !item.lon) return;

    const layerKey = {
      incidents: 'incidents',
      roadworks: 'roadworks',
      conditions: 'roadworks',
      flow: 'flow',
      tro: 'tros',
      camera: 'cameras',
      vms: 'vms',
    }[item.type] || 'roadworks';

    const marker = L.marker([item.lat, item.lon], { icon: getIcon(item) })
      .bindPopup(buildPopup(item), { maxWidth: 300 });

    marker.on('click', () => scrollToCard(item.id));

    layers[layerKey].addLayer(marker);

    // Draw road polyline for flow segments with geometry
    if (item.type === 'flow' && item.flow_data && item.flow_data.geometry && item.flow_data.geometry.length > 1) {
      const coords = item.flow_data.geometry.map(g => [g.lat, g.lon]);
      const flowColor = item.severity === 'red' ? '#ef4444' :
                         item.severity === 'amber' ? '#f59e0b' : '#22c55e';
      const congestion = item.flow_data.congestion_level || 0;
      const weight = Math.max(4, Math.min(8, 4 + congestion * 4));
      
      // Glow/outline layer
      const outline = L.polyline(coords, {
        color: flowColor,
        weight: weight + 4,
        opacity: 0.2,
        lineCap: 'round',
        lineJoin: 'round',
      });
      layers.flow.addLayer(outline);
      
      // Main coloured road line
      const line = L.polyline(coords, {
        color: flowColor,
        weight: weight,
        opacity: 0.85,
        lineCap: 'round',
        lineJoin: 'round',
      }).bindPopup(buildPopup(item), { maxWidth: 300 });
      layers.flow.addLayer(line);
    }

    const heatWeight = item.flow_data ? item.flow_data.congestion_level : 0.8;
    heatPoints.push([item.lat, item.lon, heatWeight]);
  });

  if (heatLayer) {
    map.removeLayer(heatLayer);
  }
  heatLayer = L.heatLayer(heatPoints, {
    radius: 25,
    blur: 20,
    maxZoom: 14,
    gradient: { 0.2: '#22c55e', 0.5: '#f59e0b', 0.8: '#ef4444' }
  });
  if (heatmapEnabled) {
    heatLayer.addTo(map);
  }

  // Sync layer visibility with toggle state
  syncLayerVisibility();

  renderList(data.all);
}

function syncLayerVisibility() {
  Object.keys(layers).forEach(key => {
    if (activeLayers.has(key)) {
      if (!map.hasLayer(layers[key])) layers[key].addTo(map);
    } else {
      if (map.hasLayer(layers[key])) map.removeLayer(layers[key]);
    }
  });
  // Flow tiles
  if (activeLayers.has('flow-tiles')) {
    if (flowTileLayer && !map.hasLayer(flowTileLayer)) flowTileLayer.addTo(map);
  } else {
    if (flowTileLayer && map.hasLayer(flowTileLayer)) map.removeLayer(flowTileLayer);
  }
}

// ── Sidebar List ─────────────────────────────────────────────────────────────
let allItemsFlat = [];
let searchQuery = '';

function renderList(items) {
  allItemsFlat = items;
  filterList(searchQuery);
}

function filterList(q) {
  searchQuery = (typeof q === 'string' ? q : '').toLowerCase();
  const container = document.getElementById('incident-list');

  const filtered = allItemsFlat.filter(item => {
    const layerMap = { flow: 'flow', incidents: 'incidents', camera: 'cameras', tro: 'roadworks', roadworks: 'roadworks', conditions: 'roadworks' };
    if (!activeLayers.has(layerMap[item.type] || 'roadworks')) return false;
    if (!searchQuery) return true;
    return (item.title + item.description + item.source).toLowerCase().includes(searchQuery);
  });

  if (!filtered.length) {
    container.innerHTML = `<div class="empty-state">${searchQuery ? 'No results for "' + searchQuery + '"' : 'No active events in Ayrshire'}</div>`;
    return;
  }

  const badgeClass = { incidents: 'badge-incident', roadworks: 'badge-roadworks', conditions: 'badge-roadworks', flow: 'badge-flow', tro: 'badge-tro', camera: 'badge-flow' };
  const badgeLabel = { incidents: 'Incident', roadworks: 'Roadworks', conditions: 'Condition', flow: 'Flow', tro: 'TRO', camera: 'Camera' };
  const dotColor = { red: 'var(--w-red)', amber: 'var(--w-orange)', green: 'var(--w-green)', purple: 'var(--w-purple)', cyan: '#06b6d4' };

  container.innerHTML = filtered.slice(0, 100).map(item => `
    <div class="incident-card" id="card-${item.id.replace(/[^a-z0-9]/gi,'-')}" onclick="flyToItem('${item.id.replace(/'/g,"\\'")}')">
      <div class="incident-card-header">
        <span class="severity-dot" style="background:${dotColor[item.severity] || 'var(--w-green)'}"></span>
        <div class="incident-title">${item.title}</div>
      </div>
      <div class="incident-meta">
        <span class="badge ${badgeClass[item.type] || 'badge-roadworks'}">${badgeLabel[item.type] || item.type}</span>
        <span style="margin-left:6px;font-size:11px;">${item.source}</span>
      </div>
    </div>
  `).join('');
}

function flyToItem(id) {
  const item = allItemsFlat.find(i => i.id === id);
  if (!item) return;
  map.flyTo([item.lat, item.lon], 14, { duration: 0.8 });
  setTimeout(() => {
    const layerKey = { incidents: 'incidents', roadworks: 'roadworks', conditions: 'roadworks', flow: 'flow', tro: 'tros', camera: 'cameras' }[item.type] || 'roadworks';
    layers[layerKey].eachLayer(m => {
      if (m.getLatLng().lat === item.lat && m.getLatLng().lng === item.lon) {
        m.openPopup();
      }
    });
  }, 900);
}

function scrollToCard(id) {
  const card = document.getElementById('card-' + id.replace(/[^a-z0-9]/gi,'-'));
  if (card) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// ── Layer Toggles ─────────────────────────────────────────────────────────────
function toggleLayer(el) {
  const layer = el.dataset.layer;

  if (layer === 'flow-tiles') {
    el.classList.toggle('active');
    if (el.classList.contains('active')) {
      activeLayers.add('flow-tiles');
      if (flowTileLayer) flowTileLayer.addTo(map);
    } else {
      activeLayers.delete('flow-tiles');
      if (flowTileLayer) map.removeLayer(flowTileLayer);
    }
    return;
  }

  if (layer === 'heatmap') {
    heatmapEnabled = !heatmapEnabled;
    el.classList.toggle('active', heatmapEnabled);
    if (heatmapEnabled && heatLayer) heatLayer.addTo(map);
    else if (heatLayer) map.removeLayer(heatLayer);
    return;
  }

  if (activeLayers.has(layer)) {
    activeLayers.delete(layer);
    el.classList.remove('active');
    if (layers[layer]) map.removeLayer(layers[layer]);
  } else {
    activeLayers.add(layer);
    el.classList.add('active');
    if (layers[layer]) layers[layer].addTo(map);
  }
  filterList(searchQuery);
}

// ── Status Updates ────────────────────────────────────────────────────────────
function updateStatus(data) {
  const meta = data.meta || {};
  document.getElementById('count-incidents').textContent = meta.total_incidents || 0;
  document.getElementById('count-roadworks').textContent = meta.total_roadworks || 0;
  document.getElementById('count-sources').textContent = meta.sources_active || 0;
  document.getElementById('count-cameras').textContent = meta.total_cameras || 0;

  const ferries = data.ferries || [];
  document.getElementById('count-ferries').textContent = ferries.length || 0;

  const flow = data.flow || [];
  if (flow.length) {
    const avg = flow.reduce((s, f) => s + (f.flow_data?.congestion_level || 0), 0) / flow.length;
    const pct = Math.round(avg * 100);
    document.getElementById('count-congestion').textContent = pct + '%';
    const pill = document.getElementById('congestion-pill');
    pill.className = 'pill ' + (pct > 50 ? 'red' : pct > 30 ? 'amber' : 'green');
  }

  if (meta.updated_at) {
    const d = new Date(meta.updated_at);
    document.getElementById('last-updated').textContent =
      'Updated ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
  }
}

function setConnStatus(state, text) {
  const el = document.getElementById('conn-status');
  el.className = state;
  document.getElementById('conn-text').textContent = text;
}

// ── Data Fetch ────────────────────────────────────────────────────────────────

// ── Fuel Station Layer ────────────────────────────────────────────────────────
let fuelStations = [];
async function fetchFuelStations() {
  try {
    const resp = await fetch('https://fuel.wispayr.online/api/stations');
    const data = await resp.json();
    fuelStations = data.stations || [];
    renderFuelStations();
  } catch(e) {
    console.warn('Fuel stations fetch failed:', e);
  }
}

function renderFuelStations() {
  layers.fuel.clearLayers();
  if (!fuelStations.length) return;

  fuelStations.forEach(s => {
    const lat = s.lat || (s.location && s.location.latitude);
    const lon = s.lon || (s.location && s.location.longitude);
    if (!lat || !lon) return;

    const traffic = s.traffic || {};
    const score = traffic.score || 0;
    const status = traffic.status || 'clear';

    // Price data
    const e10 = s.prices && s.prices.E10 ? s.prices.E10.price : null;
    const diesel = s.prices && s.prices.B7_STANDARD ? s.prices.B7_STANDARD.price : null;

    // Colour based on traffic near the station
    const ringColor = status === 'heavy' ? '#ef4444' :
                      status === 'moderate' ? '#f59e0b' :
                      status === 'light' ? '#3b82f6' : '#22c55e';

    // Size based on congestion
    const size = status === 'heavy' ? 18 : status === 'moderate' ? 15 : 12;

    const icon = L.divIcon({
      html: `<div style="
        width:${size}px;height:${size}px;
        background:${ringColor};
        border:2px solid white;
        border-radius:50%;
        box-shadow:0 0 ${score > 0.3 ? '8' : '4'}px ${ringColor}80;
        display:flex;align-items:center;justify-content:center;
        font-size:${size > 14 ? 10 : 8}px;
      ">⛽</div>`,
      iconSize: [size + 4, size + 4],
      iconAnchor: [(size + 4) / 2, (size + 4) / 2],
      className: 'fuel-marker'
    });

    const priceHtml = [];
    if (e10) priceHtml.push(`<span style="color:#16a34a;font-weight:700">E10: ${e10}p</span>`);
    if (diesel) priceHtml.push(`<span style="color:#2563eb;font-weight:700">Diesel: ${diesel}p</span>`);

    const trafficBadge = status !== 'clear'
      ? `<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;background:${ringColor}20;color:${ringColor}">${status.charAt(0).toUpperCase() + status.slice(1)} traffic</span>`
      : '<span style="color:#22c55e;font-size:11px;font-weight:600">✓ Clear</span>';

    const freshness = s.freshness || {};
    const freshBadge = freshness.level === 'fresh'
      ? '<span style="color:#22c55e;font-size:10px">● Fresh</span>'
      : freshness.level === 'aging'
      ? '<span style="color:#f59e0b;font-size:10px">● Aging</span>'
      : '<span style="color:#ef4444;font-size:10px">● Stale</span>';

    const popup = `
      <div style="font-family:system-ui;min-width:200px">
        <div style="font-weight:800;font-size:14px;margin-bottom:6px">⛽ ${s.name || s.trading_name}</div>
        <div style="font-size:12px;color:#9ca3af;margin-bottom:8px">${s.brand || ''} • ${s.address || (s.location && s.location.address_line_1) || ''}</div>
        <div style="display:flex;gap:12px;margin-bottom:8px">${priceHtml.join(' • ')}</div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
          ${trafficBadge} ${freshBadge}
        </div>
        ${traffic.detail ? '<div style="font-size:11px;color:#9ca3af;margin-top:4px">' + traffic.detail + '</div>' : ''}
        <div style="margin-top:8px;border-top:1px solid rgba(255,255,255,.1);padding-top:6px">
          <a href="https://fuel.wispayr.online" target="_blank" style="font-size:11px;color:#3b82f6;text-decoration:none">View on FuelPulse →</a>
        </div>
      </div>`;

    const marker = L.marker([lat, lon], { icon })
      .bindPopup(popup, { maxWidth: 320 });

    layers.fuel.addLayer(marker);
  });
  // Respect toggle state
  if (activeLayers.has('fuel')) {
    if (!map.hasLayer(layers.fuel)) layers.fuel.addTo(map);
  } else {
    if (map.hasLayer(layers.fuel)) map.removeLayer(layers.fuel);
  }
}

// Fetch fuel data on load, refresh every 5 minutes
fetchFuelStations();
setInterval(fetchFuelStations, 300000);

async function fetchTraffic() {
  setConnStatus('loading', 'Refreshing…');
  try {
    const resp = await fetch(API_BASE + '/api/traffic');
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const data = await resp.json();
    allItems = data.all || [];
    renderMarkers(data);
    updateStatus(data);
    setConnStatus('', 'Live');
    document.getElementById('loading').classList.add('hidden');
  } catch (err) {
    console.error('Fetch failed:', err);
    setConnStatus('offline', 'Offline');
  }
}

async function forceRefresh() {
  const btn = document.getElementById('refresh-btn');
  btn.style.transform = 'rotate(360deg)';
  btn.style.transition = 'transform 0.5s';
  setTimeout(() => { btn.style.transform = ''; btn.style.transition = ''; }, 500);
  await fetch(API_BASE + '/api/refresh', { method: 'POST' }).catch(() => {});
  await fetchTraffic();
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function resetView() {
  map.flyTo(AYR_CENTER, DEFAULT_ZOOM, { duration: 0.8 });
}

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('collapsed');
}

// Auto-collapse sidebar on mobile
if (window.innerWidth <= 768) {
  document.getElementById('sidebar').classList.add('collapsed');
}

// ── Init ─────────────────────────────────────────────────────────────────────
fetchTraffic();
setInterval(fetchTraffic, REFRESH_INTERVAL);

// Sync toggle UI with activeLayers on load
document.querySelectorAll('.layer-toggle').forEach(el => {
  const layer = el.dataset.layer;
  if (activeLayers.has(layer)) {
    el.classList.add('active');
  } else {
    el.classList.remove('active');
  }
});

